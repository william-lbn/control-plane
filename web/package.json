{
  "name": "@william-lbn/control-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "tsc --noEmit && vite build && node scripts/copy-swagger.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "format": "prettier --write src tests e2e recovery vite.config.ts playwright*.config.ts scripts/*.mjs scripts/*.js",
    "format:check": "prettier --check src tests e2e recovery vite.config.ts playwright*.config.ts scripts/*.mjs scripts/*.js",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swagger-ui-dist": "5.31.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
