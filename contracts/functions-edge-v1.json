{
  "version": 1,
  "component": "control-function-edge",
  "public_routes": ["/functions/v1/{branch}/{slug}", "/functions/v1/{branch}/{slug}/{rest...}"],
  "private_broker": {
    "port": 8795,
    "path": "/internal/function-edge/v1/invoke",
    "protocol": "HTTP/1.1 full-duplex NDJSON over mutual TLS 1.3",
    "client_common_name": "neon-function-edge",
    "messages": ["admission", "single_exact_manager_grant", "edge_completion", "durable_completion_ack"],
    "grant_dispatch_window_seconds": 30,
    "guest_nonce_single_use": true,
    "automatic_invocation_replay": false
  },
  "edge_credentials": ["edge_client_leaf", "broker_public_ca", "guest_public_ca"],
  "edge_has_metadata_kubernetes_sql_or_manager_credentials": false,
  "deployment": {
    "chart": "charts/neon-control-plane",
    "enable_value": "functions.edge.enabled",
    "replica_count": 1,
    "client_secret_keys": ["tls.crt", "tls.key", "broker-ca.crt"],
    "broker_secret_keys": ["tls.crt", "tls.key", "client-ca.crt"],
    "guest_ca_projection_keys": ["guest-ca.crt"],
    "client_leaf_extended_key_usage": ["ClientAuth"],
    "broker_leaf_extended_key_usage": ["ServerAuth"],
    "ca_private_keys_mounted": false,
    "service_account_token_mounted": false,
    "legacy_public_service_selector_when_disabled": "api",
    "public_service_selector_when_enabled": "function-edge"
  },
  "execution_destination": "verified_original_guest_private_ipv4_9090_tls",
  "data_plane": ["HTTP", "SSE", "WebSocket"],
  "request_body_limit_bytes": 1048576,
  "stream_deadline_seconds": 900,
  "deployment_resolution": "every_admission_current_deployment_and_original_boot_no_cross_version_cache",
  "admission_barrier": "cooperative_shared_PostgreSQL_advisory_lock_until_edge_completion",
  "usage_route": "GET /api/v1/projects/{project}/branches/{branch}/functions/{slug}/usage",
  "usage_period": "retained_lifetime",
  "resource_source": "authenticated_supervisor_original_child_cgroup_v2",
  "resource_counters": ["cpu.stat/usage_usec", "memory.current", "memory.peak"],
  "cpu_aggregation": "per_original_boot_cumulative_never_sum_per_concurrent_request",
  "missing_resource_observation": "unavailable_or_stale_never_zero_or_customer_self_report",
  "automatic_credit_debit": false,
  "deferred": ["performance", "stress", "capacity", "HA", "DR", "external_epoch_fencing", "per_request_CPU_attribution", "memory_GB_hours"]
}
