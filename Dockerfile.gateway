ARG GO_BUILDER_IMAGE
FROM ${GO_BUILDER_IMAGE} AS build
ARG GOPROXY=https://proxy.golang.org,direct
WORKDIR /src/api
COPY api/go.mod api/go.sum ./
RUN --mount=type=cache,id=neon-control-gomod-1-27,target=/go/pkg/mod go mod download
COPY api/cmd ./cmd
COPY api/internal ./internal
RUN --mount=type=cache,id=neon-control-gomod-1-27,target=/go/pkg/mod --mount=type=cache,id=neon-control-gobuild-1-27,target=/root/.cache/go-build CGO_ENABLED=0 GOMAXPROCS=2 go build -p=2 -trimpath -buildvcs=false -o /compute-gateway ./cmd/compute-gateway
FROM scratch
COPY LICENSE NOTICE /usr/share/licenses/neon-control-plane/
COPY third_party/licenses /usr/share/licenses/neon-control-plane/third_party/
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /compute-gateway /opt/neon-control/compute-gateway
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/opt/neon-control/compute-gateway"]
