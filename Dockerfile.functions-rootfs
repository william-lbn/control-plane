ARG GO_BUILDER_IMAGE
ARG NODE_BUILDER_IMAGE
FROM ${GO_BUILDER_IMAGE} AS supervisor
WORKDIR /src
COPY api/go.mod api/go.sum ./
COPY api/internal/functions ./internal/functions
COPY api/cmd/function-supervisor ./cmd/function-supervisor
RUN CGO_ENABLED=0 GOTOOLCHAIN=local GOPROXY=off go build -trimpath -ldflags='-s -w' -o /function-supervisor ./cmd/function-supervisor

# This is a guest rootfs input to own vm-builder, not a shared container service.
FROM ${NODE_BUILDER_IMAGE}
ARG DEBIAN_SNAPSHOT
USER root
# Apt still verifies Debian Release/package signatures. The fixed archive date
# bounds package resolution, and installed versions are included in the receipt.
RUN test -n "$DEBIAN_SNAPSHOT" && \
    . /etc/os-release && test "$VERSION_CODENAME" = bookworm && \
    rm -f /etc/apt/sources.list.d/debian.sources && \
    printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s/ bookworm main\ndeb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/%s/ bookworm-security main\n' "$DEBIAN_SNAPSHOT" "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 update && \
    apt-get install -y --no-install-recommends iptables util-linux ca-certificates && \
    update-alternatives --set iptables /usr/sbin/iptables-legacy && \
    mkdir -p /opt/neon/functions /lib/udev/rules.d && \
    printf 'isolated-neonvm-functions-v1\n' > /etc/neon-function-guest && \
    printf 'SUBSYSTEM=="block", OWNER="root", GROUP="root", MODE="0600"\n' > /lib/udev/rules.d/99-function-block.rules && \
    dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' > /opt/neon/functions/guest-packages.txt && \
    rm -rf /var/lib/apt/lists/*
COPY --from=supervisor /function-supervisor /usr/local/bin/function-supervisor
COPY services/functions/runtime /opt/neon/functions/runtime
RUN chmod 0755 /usr/local/bin/function-supervisor && \
    chmod -R go-w /opt/neon/functions && \
    test ! -e /srv/function && \
    /usr/local/bin/node --version && /usr/bin/setpriv --version && /sbin/iptables --version
ENTRYPOINT ["/usr/local/bin/function-supervisor"]
