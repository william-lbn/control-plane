{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "configSecret", "signingSecret", "upstreamCASecret", "service", "ingress", "laboratory", "resources", "nodeSelector", "tolerations"],
  "additionalProperties": false,
  "properties": {
    "image": {"type":"object","required":["reference","pullPolicy"],"additionalProperties":false,"properties":{"reference":{"type":"string","pattern":"^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"},"pullPolicy":{"enum":["Always","IfNotPresent"]}}},
    "replicaCount": {"type":"integer","const":1},
    "configSecret": {"type":"string","minLength":1,"maxLength":253,"pattern":"^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "signingSecret": {"type":"string","minLength":1,"maxLength":253,"pattern":"^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "upstreamCASecret": {"type":"string","maxLength":253,"pattern":"^$|^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
    "service": {"type":"object","required":["type","nodePort"],"additionalProperties":false,"properties":{"type":{"enum":["ClusterIP","NodePort"]},"nodePort":{"type":"integer","anyOf":[{"const":0},{"minimum":30000,"maximum":32767}]}}},
    "ingress": {"type":"object","required":["enabled","className","host","tlsSecret"],"additionalProperties":false,"properties":{"enabled":{"type":"boolean"},"className":{"type":"string"},"host":{"type":"string"},"tlsSecret":{"type":"string"}}},
    "laboratory": {"type":"object","required":["allowHTTP"],"additionalProperties":false,"properties":{"allowHTTP":{"type":"boolean"}}},
    "resources": {"type":"object","required":["requests","limits"],"additionalProperties":false,"properties":{"requests":{"$ref":"#/definitions/quantities"},"limits":{"$ref":"#/definitions/quantities"}}},
    "nodeSelector": {"type":"object","additionalProperties":{"type":"string"}},
    "tolerations": {"type":"array","items":{"type":"object"}}
  },
  "definitions": {
    "quantities": {"type":"object","required":["cpu","memory"],"additionalProperties":false,"properties":{"cpu":{"type":"string"},"memory":{"type":"string"}}}
  }
}
