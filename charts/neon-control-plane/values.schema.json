{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "api",
    "web",
    "service"
  ],
  "properties": {
    "worker": {
      "type": "object",
      "required": [
        "enabled",
        "replicaCount"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "const": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "api": {
      "type": "object",
      "required": [
        "image",
        "replicaCount",
        "existingSecret",
        "pgTLSMode"
      ],
      "properties": {
        "replicaCount": {
          "type": "integer",
          "const": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "pgTLSMode": {
          "enum": [
            "verify-full",
            "lab-insecure"
          ]
        },
        "computeImage": {
          "type": "string",
          "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
        },
        "image": {
          "$ref": "#/definitions/image",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          }
        },
        "creationEnabled": {
          "type": "boolean"
        },
        "scaleToZeroEnabled": {
          "type": "boolean"
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "proxyHost": {
          "type": "string"
        },
        "proxyPort": {
          "type": "integer"
        },
        "publicProxyHost": {
          "type": "string"
        },
        "publicProxyPort": {
          "type": "integer"
        },
        "pgCASecret": {
          "type": "string"
        },
        "computeGatewayURL": {
          "type": "string"
        },
        "computeControlHost": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "pitrEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "web": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "$ref": "#/definitions/image",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort"
          ]
        },
        "nodePort": {
          "type": "integer",
          "minimum": 30000,
          "maximum": 32767
        },
        "port": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "dataAPI": {
      "type": "object",
      "required": [
        "enabled",
        "labHTTP",
        "gatewayImage",
        "postgrestImage"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labHTTP": {
          "type": "boolean"
        },
        "gatewayImage": {
          "type": "string"
        },
        "postgrestImage": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "labHTTP": {
                "const": true
              },
              "gatewayImage": {
                "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
              },
              "postgrestImage": {
                "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "backendCredentials": {
      "type": "object",
      "required": [
        "enabled",
        "existingSecret",
        "labHTTP"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "labHTTP": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "fullnameOverride": {
      "type": "string"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": true
    },
    "tolerations": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": true
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "managedAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "labHTTP",
        "runtimeImage",
        "publicOrigin",
        "pgCASecret",
        "pgCAKey",
        "pgServerName"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labHTTP": {
          "type": "boolean"
        },
        "runtimeImage": {
          "type": "string"
        },
        "publicOrigin": {
          "type": "string"
        },
        "pgCASecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "pgCAKey": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,253}$"
        },
        "pgServerName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-zA-Z0-9.-]+$"
        },
        "mail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "existingSecret"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "existingSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "labMailbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "acknowledged",
            "image",
            "existingAuthSecret",
            "existingClaim",
            "storageClass",
            "storageSize"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "acknowledged": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "pattern": "^docker\\.io/axllent/mailpit@sha256:[a-f0-9]{64}$"
            },
            "existingAuthSecret": {
              "type": "string",
              "pattern": "^$|^[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "storageSize": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(Mi|Gi)$"
            },
            "nodeSelector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "existingAuthSecret": {
                    "minLength": 1
                  },
                  "acknowledged": {
                    "const": true
                  }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "labHTTP": {
                "const": true
              },
              "runtimeImage": {
                "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
              },
              "publicOrigin": {
                "pattern": "^https?://[^/\\s*?#@]+$"
              }
            }
          }
        }
      ]
    },
    "objectStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9][a-z0-9.-]{0,252}$"
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "origin",
            "region",
            "labHTTP",
            "serviceType",
            "nodePort"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "origin": {
              "type": "string",
              "maxLength": 255
            },
            "region": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            },
            "labHTTP": {
              "type": "boolean"
            },
            "serviceType": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "existingSecret": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "functions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingConfigSecret",
        "existingIssuerSecret",
        "proxyCASecret",
        "proxyCAKey"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingConfigSecret": {
          "type": "string",
          "maxLength": 253
        },
        "existingIssuerSecret": {
          "type": "string",
          "maxLength": 253
        },
        "proxyCASecret": {
          "type": "string",
          "maxLength": 253
        },
        "proxyCAKey": {
          "type": "string",
          "maxLength": 253
        },
        "publicHTTP": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "origin",
            "labHTTP",
            "serviceType",
            "nodePort"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "origin": {
              "type": "string",
              "maxLength": 255
            },
            "labHTTP": {
              "type": "boolean"
            },
            "serviceType": {
              "enum": [
                "ClusterIP",
                "NodePort"
              ]
            },
            "nodePort": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          }
        },
        "schedules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "objectEvents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "outputLogs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "branchCopies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "managerCertificateRenewal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "renewBeforeSeconds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "renewBeforeSeconds": {
              "type": "integer",
              "minimum": 600,
              "maximum": 7140
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "existingConfigSecret": {
                "minLength": 1
              },
              "existingIssuerSecret": {
                "minLength": 1
              },
              "proxyCASecret": {
                "minLength": 1
              },
              "proxyCAKey": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "aiGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "existingConfigSecret",
        "existingDatabaseSecret",
        "labHTTP",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "existingConfigSecret": {
          "type": "string"
        },
        "existingDatabaseSecret": {
          "type": "string"
        },
        "labHTTP": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "sqlHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "aiProviderManagement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingPublicSecret",
        "existingPrivateSecret"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingPublicSecret": {
          "type": "string"
        },
        "existingPrivateSecret": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "reference",
        "pullPolicy"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
